{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit(./.audit/**)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git status:*)",
      "Bash(wc:*)",
      "Bash(date -u:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(sed -n:*)",
      "Bash(.audit-kit/bin/checkpoint:*)",
      "Bash(.audit-kit/bin/kit query:*)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:azure.github.io)",
      "WebFetch(domain:expressjs.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:cheatsheetseries.owasp.org)",
      "WebFetch(domain:owasp.org)",
      "WebFetch(domain:www.w3.org)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:cyber.gov.au)",
      "WebFetch(domain:olg.nsw.gov.au)",
      "WebFetch(domain:digital.gov.au)",
      "WebFetch(domain:eslint.org)",
      "WebFetch(domain:best.openssf.org)",
      "WebFetch(domain:ota-meshi.github.io)"
    ],
    "deny": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(bun:*)",
      "Bash(deno:*)",
      "Bash(uv:*)",
      "Bash(pip:*)",
      "Bash(make:*)",
      "Bash(bash:*)",
      "Bash(sh:*)",
      "Bash(zsh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset:*)",
      "Bash(git restore:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.audit-kit/bin/kit hook",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "audit-accessibility|audit-architect|audit-discovery|audit-engineer|audit-lead-reviewer|audit-security|audit-verifier",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.audit-kit/bin/kit hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
